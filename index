<title>Cotality Web Messaging</title>
<style>
  :root {
    --bg: #F3F6F7;
    --surface: #FFFFFF;
    --surface-hover: #FAFBFB;
    --navy: #0A1522;
    --navy-2: #0E1F30;
    --line: #1C2E3D;
    --border: #E1E7E9;
    --text: #1A2733;
    --text-muted: #556677;
    --text-faint: #9FB0BC;
    --accent: #1FA8A0;
    --accent-ink: #061019;
    --accent-wash: rgba(31,168,160,0.12);
    --accent-wash-strong: rgba(31,168,160,0.4);
    --shadow: 0 2px 18px rgba(10,21,34,0.06);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0B131C;
      --surface: #131F2C;
      --surface-hover: #17232F;
      --border: #22333F;
      --text: #E7EEF2;
      --text-muted: #93A6B5;
      --text-faint: #5E7284;
      --shadow: 0 2px 18px rgba(0,0,0,0.35);
    }
  }
  :root[data-theme="dark"] {
    --bg: #0B131C;
    --surface: #131F2C;
    --surface-hover: #17232F;
    --border: #22333F;
    --text: #E7EEF2;
    --text-muted: #93A6B5;
    --text-faint: #5E7284;
    --shadow: 0 2px 18px rgba(0,0,0,0.35);
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Manrope', system-ui, sans-serif;
  }
  h1, h2, h3, .display {
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  .row { display: flex; align-items: center; }

  header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--navy);
    border-bottom: 2px solid var(--accent);
    padding: 0 clamp(16px, 5vw, 56px);
    height: 72px;
  }
  .brand-badge {
    background: var(--accent);
    color: var(--accent-ink);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
    padding: 7px 16px;
    border-radius: 6px;
  }
  .divider-v { width: 1px; height: 24px; background: #22384A; }
  .eyebrow-label {
    font-size: 12.5px;
    font-weight: 500;
    color: #7E93A3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .env-pill {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-wash);
    border: 1px solid var(--accent-wash-strong);
    padding: 6px 14px;
    border-radius: 20px;
    white-space: nowrap;
  }

  .hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 100%);
    padding: 48px clamp(16px, 5vw, 56px) 44px;
  }
  .hero-eyebrow {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero h1 {
    margin: 0 0 12px;
    font-weight: 700;
    font-size: clamp(26px, 4vw, 36px);
    line-height: 1.2;
    color: #FFFFFF;
    max-width: 640px;
    text-wrap: balance;
  }
  .hero h1 span { color: var(--accent); }
  .hero p {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: #93A6B5;
    max-width: 560px;
  }

  main {
    max-width: 1160px;
    margin: 0 auto;
    padding: 36px clamp(16px, 5vw, 56px) 64px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
  }

  .prompts-panel {
    flex: 1 1 560px;
    min-width: 280px;
    overflow: hidden;
  }
  .panel-head {
    background: var(--navy);
    padding: 18px 22px;
    justify-content: space-between;
  }
  .panel-head h2 { margin: 0; font-size: 16.5px; font-weight: 600; color: #FFFFFF; }
  .count-pill {
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 12px;
  }

  .tabs {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    padding: 0 18px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-hover);
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab {
    background: none;
    border: none;
    font-family: inherit;
    padding: 12px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-faint);
    white-space: nowrap;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--text); border-bottom-color: var(--accent); }

  .prompt-list { max-height: 480px; overflow-y: auto; padding: 6px 0; }
  .prompt-item {
    justify-content: space-between;
    padding: 12px 22px;
    border-bottom: 1px solid var(--border);
    gap: 14px;
    cursor: pointer;
  }
  .prompt-item:hover { background: var(--surface-hover); }
  .prompt-item:last-child { border-bottom: none; }
  .prompt-text { font-size: 13.5px; line-height: 1.4; color: var(--text); }
  .prompt-cat {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-top: 3px;
  }
  .copy-btn {
    flex-shrink: 0;
    font-family: inherit;
    background: none;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 5px 11px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
  }
  .copy-btn:hover { background: var(--accent-wash); border-color: var(--accent-wash-strong); color: var(--accent); }
  .copy-btn.copied { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

  .sidebar { flex: 0 0 300px; min-width: 260px; display: flex; flex-direction: column; gap: 20px; }

  .status-card { background: var(--navy); border-radius: 14px; padding: 22px; }
  .status-card h3 { margin: 0 0 16px; font-size: 15px; font-weight: 600; color: var(--accent); }
  .status-row { justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .status-row:last-child { border-bottom: none; }
  .status-row .label { font-size: 12px; color: #7E93A3; }
  .status-row .value { color: #DCE3E6; font-weight: 500; }
  .status-row .mono { font-family: 'DM Mono', 'Courier New', monospace; font-size: 11px; color: #55697A; }
  .status-live { display: inline-flex; align-items: center; gap: 6px; color: #37C98F; font-weight: 600; }
  .status-dot {
    width: 7px; height: 7px; border-radius: 50%; background: #37C98F;
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .tips-card { padding: 22px; }
  .tips-card h3 {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    padding-bottom: 10px;
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }
  .tips-list { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .tips-list li {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-muted);
    padding-left: 16px;
    position: relative;
  }
  .tips-list li::before { content: '→'; position: absolute; left: 0; color: var(--accent); font-weight: 600; }

  footer {
    background: var(--navy);
    padding: 18px clamp(16px, 5vw, 56px);
    padding-bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }
  footer span { font-size: 12px; }
  footer .left { color: #445A6B; }
  footer .right { color: #2E3F4C; }

  @media (max-width: 720px) {
    header { padding: 0 16px; }
    .env-pill { display: none; }
  }
</style>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<header class="row" style="justify-content: space-between;">
  <div class="row" style="gap: 18px;">
    <div class="brand-badge">Cotality</div>
    <div class="divider-v"></div>
    <span class="eyebrow-label">Genesys Web Messaging</span>
  </div>
  <div class="env-pill">Sandbox · Test Build</div>
</header>

<div class="hero">
  <p class="hero-eyebrow">Bot Testing Interface</p>
  <h1>Web Messaging <span>Test Page</span></h1>
  <p>Use the prompts below to test the Cotality Web Messaging bot. Copy any prompt and paste it into the chat widget in the bottom-right corner to validate its response.</p>
</div>

<main>
  <section class="card prompts-panel">
    <div class="row panel-head">
      <h2>Suggested Test Prompts</h2>
      <span class="count-pill" id="visible-count">17</span>
    </div>
    <div class="tabs" id="tabs"></div>
    <div class="prompt-list" id="prompt-list"></div>
  </section>

  <aside class="sidebar">
    <div class="status-card">
      <h3>Session Status</h3>
      <div class="row status-row">
        <span class="label">Widget</span>
        <span class="status-live"><span class="status-dot"></span>Live</span>
      </div>
      <div class="row status-row">
        <span class="label">Org</span>
        <span class="value">Cotality</span>
      </div>
      <div class="row status-row">
        <span class="label">Knowledge base</span>
        <span class="value">17 articles loaded</span>
      </div>
      <div class="row status-row">
        <span class="label">Environment</span>
        <span class="mono">prod-usw2</span>
      </div>
    </div>

    <div class="card tips-card">
      <h3>How to Test</h3>
      <ul class="tips-list">
        <li>Open the chat widget via the button in the <strong>bottom-right corner</strong> of this page.</li>
        <li>Click <strong>Copy</strong> on any prompt and paste it into the widget.</li>
        <li>Confirm the bot responds with the matching knowledge base answer.</li>
        <li>Test escalation with phrases like "speak to an agent."</li>
        <li>Use the category tabs to focus on one workflow at a time.</li>
      </ul>
    </div>
  </aside>
</main>

<footer class="row">
  <span class="left">Cotality × Genesys Cloud CX — Internal Test Build</span>
  <span class="right">Widget loads bottom-right automatically</span>
</footer>

<script>
  const categories = {
    "All": null,
    "Credit Ops": [
      "What does this credit inquiry or alert mean?",
      "Can this credit report be updated?",
      "There’s something wrong with this credit report."
    ],
    "Tax & Platform": [
      "Why can’t I log in to the platform?",
      "Is this tax data current?",
      "I can’t find the tax record I need."
    ],
    "Commercial Tax": [
      "I got a tax notice even though this should have been handled.",
      "Why does this property still show delinquent?",
      "Did my tax payment go through?"
    ],
    "Corporate Accounting": [
      "Can you explain this invoice amount?",
      "Why was I charged twice?"
    ],
    "Inside Sales": [
      "Who should I talk to about getting started?",
      "Can I get a demo of Cotality?",
      "How do I get pricing information?",
      "Which Cotality solution is right for my workflow?",
      "Can someone contact me about a sales conversation?",
      "I’m interested in learning more about your products."
    ]
  };

  const allPrompts = Object.keys(categories)
    .filter((c) => c !== "All")
    .flatMap((cat) => categories[cat].map((text) => ({ cat, text })));

  let activeTab = "All";

  const tabsEl = document.getElementById('tabs');
  Object.keys(categories).forEach((cat) => {
    const btn = document.createElement('button');
    btn.className = 'tab' + (cat === 'All' ? ' active' : '');
    btn.textContent = cat;
    btn.onclick = () => {
      document.querySelectorAll('.tab').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeTab = cat;
      renderPrompts();
    };
    tabsEl.appendChild(btn);
  });

  function renderPrompts() {
    const list = document.getElementById('prompt-list');
    list.innerHTML = '';
    const source = activeTab === 'All' ? allPrompts : allPrompts.filter((p) => p.cat === activeTab);
    document.getElementById('visible-count').textContent = source.length;

    source.forEach((p) => {
      const item = document.createElement('div');
      item.className = 'row prompt-item';

      const textWrap = document.createElement('div');
      textWrap.style.minWidth = '0';
      const textEl = document.createElement('div');
      textEl.className = 'prompt-text';
      textEl.textContent = p.text;
      const catEl = document.createElement('div');
      catEl.className = 'prompt-cat';
      catEl.textContent = p.cat;
      textWrap.appendChild(textEl);
      textWrap.appendChild(catEl);

      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-btn';
      copyBtn.textContent = 'Copy';
      copyBtn.onclick = (e) => {
        e.stopPropagation();
        copyPrompt(p.text, copyBtn);
      };

      item.appendChild(textWrap);
      item.appendChild(copyBtn);
      item.onclick = () => copyPrompt(p.text, copyBtn);
      list.appendChild(item);
    });
  }

  function copyPrompt(text, btn) {
    function fallbackCopy(t) {
      const ta = document.createElement('textarea');
      ta.value = t;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try { document.execCommand('copy'); } catch (err) {}
      document.body.removeChild(ta);
    }
    function markCopied() {
      const original = btn.textContent;
      btn.textContent = '✓ Copied';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = original === '✓ Copied' ? 'Copy' : original;
        btn.classList.remove('copied');
      }, 1600);
    }
    try {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(markCopied).catch(() => { fallbackCopy(text); markCopied(); });
      } else {
        fallbackCopy(text);
        markCopied();
      }
    } catch (err) {
      fallbackCopy(text);
      markCopied();
    }
  }

  renderPrompts();
</script>

